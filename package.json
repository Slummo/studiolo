{
  "name": "studiolo",
  "version": "1.0.2",
  "private": true,
  "description": "Obsidian plugin: a daily page with a pomodoro timer, a kanban board and notes.",
  "main": "src/main.js",
  "scripts": {
    "build": "node --check src/main.js && node -e \"require('fs').copyFileSync('src/main.js', 'main.js')\"",
    "pretest": "npm run build",
    "test": "node test/run.js",
    "check": "node --check src/main.js"
  },
  "devDependencies": {
    "jsdom": "^24.0.0",
    "moment": "^2.30.1"
  },
  "license": "MIT"
}
